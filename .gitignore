# Routine journals, mission briefs, and progress logs beside kitchens (local; not product)
*.journal.json
stacked-task-set*.resume.json
*.next.md
*.progress.log

# Review-round markers beside kitchens (local; not product)
**/review/round-*/base.sha
**/review/round-*/closed

# Herdr pane-command oracle logs beside kitchens (local; not product)
oracle-*.log

# Task-work host progress lines beside kitchens (local; not product)
task-work.progress.log

# Mission heartbeat in the claim worktree (local; not product)
mission.heartbeat

# Per-user tool state (XDG .local/, e.g. gh device-id; local; not product)
.local/
# AOT dev CLI (self-install output; local; not product)
bin/dev
# AOT dev CLI debug companion (self-install output; local; not product)
bin/dev.dbg
# AOT dev CLI on Windows (self-install output; local; not product)
bin/dev.exe

# Build output. bin/dev* above stays ignored with the rest of bin/.
[Bb]in/
[Oo]bj/
artifacts/

# VS Code workspace settings: Peacock rewrites this on open
.vscode/settings.json
