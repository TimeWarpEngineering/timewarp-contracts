<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Central Package Management - package versions are pinned from discovered references -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
<ItemGroup><PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0"><PrivateAssets>all</PrivateAssets><IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets></PackageVersion><PackageVersion Include="TimeWarp.Nuru" Version="4.0.0-beta.11" /><PackageVersion Include="TimeWarp.Nuru.DevCli" Version="4.0.0-beta.11" /><PackageVersion Include="TimeWarp.Amuru" Version="2.0.0" /><PackageVersion Include="TimeWarp.Amuru.Tools" Version="2.0.0" /><PackageVersion Include="TimeWarp.Terminal" Version="1.0.2" /><PackageVersion Include="TimeWarp.SourceGenerators" Version="1.0.0-beta.11" /><PackageVersion Include="TimeWarp.Build.Tasks" Version="1.0.0" /></ItemGroup></Project>
